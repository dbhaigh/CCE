{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/index.ts", "src/simulation/**/*.ts", "src/app/game.ts", "src/app/protocol.ts", "src/app/worker-runtime.ts", "src/app/save-queue.ts", "src/app/bridge.ts", "src/app/simulation-store.ts", "src/app/simulation-loop.ts", "test/**/*.ts"]
}
